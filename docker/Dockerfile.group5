# ==============================================================================
# Academic Blockchain Consortium — Group 5 Standalone Microservice
# Module: Ledger AI Assistant & Encrypted Event Hub (Contributors 5.1, 5.2, 5.3)
# ==============================================================================

# Multi-stage build for ultra-clean, minimal production image
FROM node:22-alpine AS builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Production Stage
FROM node:22-alpine

WORKDIR /app

# Install Docker CLI to execute Fabric peer queries if needed
RUN apk add --no-cache docker-cli bash curl

# Install backend dependencies
COPY backend/package*.json ./
RUN npm install --omit=dev

# Copy backend source
COPY backend/src ./src
COPY backend/storage ./storage

# Copy built frontend from builder stage
COPY --from=builder /app/frontend/dist ./frontend/dist
COPY frontend/server.js ./frontend/server.js
COPY frontend/public ./frontend/public

# Default environment variables
ENV PORT=4000
ENV FRONTEND_PORT=3000
ENV NODE_ENV=production
ENV CHANNEL_NAME=academicchannel
ENV CHAINCODE_NAME=academic-contract
ENV LEDGER_ENCRYPTION_SECRET=NITW-Academic-Blockchain-Ledger-Secret-2026

EXPOSE 4000 3000

# Supervisor start script for running both backend and frontend server concurrently
CMD ["sh", "-c", "node src/server.js & node frontend/server.js"]
